#!/bin/sh

if [ -x ../qdtogrib ]; then
  PROG=../qdtogrib
  QDINFO=../qdinfo
  PROG_OPTS="-c ../cnf/grib.conf"
else
  PROG=qdtogrib
  QDINFO=qdinfo
  PROG_OPTS=""
fi

errors=0

for f in data/qdtogrib/*; do
    name=$(basename $f .fqd)
    resultfile=results/qdtogrib/${name}.grib2

    tmpfile=${resultfile}.tmp
    $PROG ${PROG_OPTS} -2 $f $tmpfile
    cmp --quiet $resultfile $tmpfile
    ERR=$?
    printf '%-60s' "$name"
    if [[ $ERR -eq 0 ]]; then
	echo OK
	rm -f $tmpfile
    else
	errors=$(($errors+1))
	echo FAILED
    fi
done

echo $errors errors
exit $errors
